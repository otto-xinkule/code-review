# ============================================
# AI PR Review - Environment Configuration
# ============================================

# --- GitHub Integration ---
# Required: GitHub personal access token with repo scope
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub repository (format: owner/repo)
GITHUB_REPOSITORY=owner/repo

# --- GitHub Webhook (optional) ---
# Webhook secret for verifying GitHub webhook payloads
WEBHOOK_SECRET=your_webhook_secret_here
# Port for webhook server
WEBHOOK_PORT=3000

# --- AI Model Providers ---
# Anthropic API key (Claude models)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# OpenAI API key (GPT-4 models)
OPENAI_API_KEY=sk-your_openai_key_here

# DeepSeek API key
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# Qwen API key (DashScope / Alibaba Cloud)
QWEN_API_KEY=sk-your_qwen_key_here

# --- Model Configuration ---
# Default model for PR review (claude-opus-4-20240229, gpt-4o, deepseek-coder, qwen2.5-coder)
DEFAULT_MODEL=claude-opus-4-20240229

# Whether to enable automatic model routing based on PR characteristics
ENABLE_MODEL_ROUTING=true

# Fallback model if primary model fails
FALLBACK_MODEL=gpt-4o

# --- Review Configuration ---
# Maximum diff size to process (in bytes, default 500KB)
MAX_DIFF_SIZE=512000

# Maximum number of files in a PR before chunking
MAX_FILES_PER_CHUNK=15

# Token budget for prompt (total tokens for input)
TOKEN_BUDGET=8000

# Confidence threshold for reporting issues (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7

# Maximum number of inline comments per file
MAX_INLINE_COMMENTS_PER_FILE=5

# --- Risk Detection Configuration ---
# Enable/disable specific risk categories
CHECK_SECURITY=true
CHECK_PERFORMANCE=true
CHECK_BUGS=true
CHECK_LOGIC=true
CHECK_MAINTAINABILITY=true

# Minimum severity level to report (critical, high, medium, low)
MIN_SEVERITY_LEVEL=medium

# --- Feature Flags ---
# Enable feedback learning from developer responses
ENABLE_FEEDBACK_LEARNING=true

# Enable PR summary generation
ENABLE_SUMMARY=true

# Enable risk detection
ENABLE_RISK_DETECTION=true

# Enable suggestion generation
ENABLE_SUGGESTIONS=true

# Enable automatic comment updates when PR changes
ENABLE_AUTO_UPDATE_REVIEW=true

# --- Logging ---
# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# --- Advanced ---
# Request timeout in milliseconds
REQUEST_TIMEOUT=300000

# Maximum retries for API calls
MAX_RETRIES=3

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600
